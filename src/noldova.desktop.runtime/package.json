{
  "name": "@noldova/desktop.runtime",
  "version": "__VERSION__",
  "description": "Noldova Desktop's runtime: it owns a data directory, hosts modules' runtime parts and keeps their state, and the client side that finds, starts and connects to it.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noldova-com/desktop.git",
    "directory": "src/noldova.desktop.runtime"
  },
  "homepage": "https://github.com/noldova-com/desktop#readme",
  "bugs": {
    "url": "https://github.com/noldova-com/desktop/issues"
  },
  "exports": {
    ".": {
      "types": "./api/index.d.ts",
      "default": "./api/index.js"
    },
    "./testing": {
      "types": "./api/testing.d.ts",
      "default": "./api/testing.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "**/*.js",
    "**/*.js.map",
    "native/*/*.node",
    "api/index.d.ts",
    "api/testing.d.ts"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@noldova/desktop.protocol": "__VERSION__"
  },
  "peerDependencies": {
    "@noldova/context.core": ">=0.0.7 <0.1.0",
    "@noldova/context.exceptions": ">=0.0.7 <0.1.0",
    "@noldova/context.json": ">=0.0.7 <0.1.0",
    "@noldova/context.text": ">=0.0.7 <0.1.0",
    "@types/node": ">=26.6.6 <27.0.0"
  },
  "peerDependenciesMeta": {
    "@types/node": {
      "optional": true
    }
  },
  "noldova": {
    "windowsAddons": [
      "windows-process"
    ],
    "posixAddons": [
      "posix-process"
    ]
  }
}
